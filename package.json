{
  "name": "septic",
  "version": "2.0.0",
  "description": "Config-driven backend for the poops ecosystem: one poops.json, a SQLite schema + REST CRUD + auth.",
  "type": "module",
  "bin": {
    "septic": "bin/septic.js"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "bin",
    "assets",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node bin/septic.js serve",
    "test": "node --test",
    "lint": "eslint .",
    "docs:build": "poops --build -c docs/poops.json",
    "docs:serve": "poops -c docs/poops.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "express": "^5.2.1",
    "js-yaml": "^5.2.1",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "unknown-keys": "^1.1.0"
  },
  "peerDependencies": {
    "poops": "*"
  },
  "peerDependenciesMeta": {
    "poops": {
      "optional": true
    }
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "eslint": "^9.39.3",
    "neostandard": "^0.13.0",
    "poops": "^2.1.0",
    "poops-docs-theme": "^3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stamat/septic.git"
  },
  "bugs": {
    "url": "https://github.com/stamat/septic/issues"
  },
  "homepage": "https://github.com/stamat/septic#readme",
  "keywords": [
    "poops",
    "backend",
    "sqlite",
    "rest",
    "crud",
    "config-driven"
  ],
  "license": "MIT",
  "author": "Stamat <@stamat> (http://stamat.info)"
}
